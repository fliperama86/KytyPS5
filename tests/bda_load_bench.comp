#version 460

// Micro-benchmark shader for the cost of a guest memory read.
//
// VARIANT 0 reads through a normally bound storage buffer.
// VARIANT 1 reads through the emulator's buffer-device-address page table, reproducing the shape of
//           DefineGetBdaPointer / LoadBdaDword in
//           src/graphics/shader/recompiler/backend/spirv/spirvEmitterMemory.cpp: shift the guest
//           address down by CACHING_PAGEBITS, index a storage buffer of 64-bit device addresses,
//           compare the entry to zero, branch, set a fault bit on a miss, otherwise add the in-page
//           offset and load through a PhysicalStorageBuffer pointer with an alignment of four.
// VARIANT 2 additionally chases a three level descriptor chain through the same path before every
//           block of loads, modelling an in-shader SRT walk.
//
// PATTERN 3 (chain-latency) replaces the block of independent loads with a single dependent one:
//           the address of step i+1 is derived from the value step i loaded, so nothing overlaps
//           and the dispatch time divided by the step count is the latency of one dependent guest
//           read. Every lane of the group walks the same chain, which is the shape of a prologue's
//           scalar SRT walk, and the addresses are scattered over the whole region so consecutive
//           steps touch a different 64 byte line and a different 16 KB page.

#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

layout(local_size_x = 64) in;

layout(constant_id = 0) const int VARIANT = 0; // 0 = bound SSBO, 1 = BDA, 2 = BDA + SRT prologue
layout(constant_id = 1) const int PATTERN = 0; // 0 = uniform, 1 = strided, 2 = scattered,
                                               // 3 = chain-latency

const uint     PAGE_BITS = 14u; // BufferCache::CACHING_PAGEBITS
const uint64_t PAGE_MASK = (1ul << PAGE_BITS) - 1ul;
const uint     LOADS     = 16u;

layout(buffer_reference, std430, buffer_reference_align = 4) readonly buffer BdaU32 {
	uint value;
};

layout(set = 0, binding = 0, std430) readonly buffer PageTable {
	uint64_t entry[];
} page_table;

layout(set = 0, binding = 1, std430) buffer FaultBits {
	uint word[];
} fault;

layout(set = 0, binding = 2, std430) readonly buffer GuestMemory {
	uint dword[];
} guest;

layout(set = 0, binding = 3, std430) writeonly buffer Sink {
	uint value[];
} sink;

layout(push_constant) uniform Push {
	uint64_t guest_base; // guest address of the first byte of the guest memory buffer
	uint64_t srt_base;   // guest address of the level one descriptor table
	uint     iterations;
	uint     span_mask;  // (region size - 1) with the low two bits cleared
} pc;

uint64_t get_bda_pointer(uint64_t address) {
	uint     page   = uint(address >> PAGE_BITS);
	uint64_t base   = page_table.entry[page];
	uint64_t result = 0ul;
	if (base == 0ul) {
		uint word       = page >> 5u;
		fault.word[word] = fault.word[word] | (1u << (page & 31u));
	} else {
		result = base + (address & PAGE_MASK);
	}
	return result;
}

uint load_bda_dword(uint64_t address) {
	uint64_t bda   = get_bda_pointer(address);
	uint     value = 0u;
	if (bda != 0ul) {
		value = BdaU32(bda).value;
	}
	return value;
}

uint scatter(uint seed, uint n) {
	uint x = seed + n * 2654435761u;
	x ^= x >> 15u;
	x *= 0x2c1b3c6du;
	x ^= x >> 15u;
	return x;
}

void main() {
	uint lane    = gl_LocalInvocationID.x;
	uint wg      = gl_WorkGroupID.x;
	uint gid     = gl_GlobalInvocationID.x;
	uint groups  = gl_NumWorkGroups.x;
	uint mask    = pc.span_mask;
	uint seed    = scatter(0x9e3779b9u, wg * 64u + lane);
	uint acc     = 0u;
	// chain-latency start: lane uniform, one independent chain per workgroup.
	uint chain   = (scatter(0x12345678u, wg) << 2u) & mask;

	for (uint i = 0u; i < pc.iterations; ++i) {
		uint64_t data_base = pc.guest_base;

		if (VARIANT == 2) {
			// user data root -> descriptor table -> V#, all through the page table
			uint     slot   = i & 63u;
			uint64_t l1     = pc.srt_base + uint64_t(slot * 16u);
			uint64_t table  = uint64_t(load_bda_dword(l1)) |
			                 (uint64_t(load_bda_dword(l1 + 4ul)) << 32);
			uint64_t l2     = table + uint64_t(slot * 8u);
			uint64_t vsharp = uint64_t(load_bda_dword(l2)) |
			                 (uint64_t(load_bda_dword(l2 + 4ul)) << 32);
			uint d0 = load_bda_dword(vsharp);
			uint d1 = load_bda_dword(vsharp + 4ul);
			uint d2 = load_bda_dword(vsharp + 8ul);
			uint d3 = load_bda_dword(vsharp + 12ul);
			data_base = uint64_t(d0) | (uint64_t(d1 & 0xffffu) << 32);
			acc += d2 + d3;
		}

		if (PATTERN == 3) {
			// One load per step, and the next address depends on the value this one returns.
			uint v;
			if (VARIANT == 0) {
				v = guest.dword[chain >> 2u];
			} else {
				v = load_bda_dword(data_base + uint64_t(chain));
			}
			acc  += v;
			chain = (scatter(v, i) << 2u) & mask;
			continue;
		}

		for (uint k = 0u; k < LOADS; ++k) {
			uint off;
			if (PATTERN == 0) {
				// uniform: every lane of the group reads the same 64 bytes
				off = (wg * 64u + i * (groups * 64u) + k * 4u) & mask;
			} else if (PATTERN == 1) {
				// strided: a 64 byte record per lane, vertex fetch style
				off = (wg * 4096u + i * (groups * 4096u) + lane * 64u + k * 4u) & mask;
			} else {
				// scattered: a pseudo-random dword anywhere in the region
				off = (scatter(seed, i * LOADS + k) << 2u) & mask;
			}
			if (VARIANT == 0) {
				acc += guest.dword[off >> 2u];
			} else {
				acc += load_bda_dword(data_base + uint64_t(off));
			}
		}
	}

	sink.value[gid] = acc;
}
